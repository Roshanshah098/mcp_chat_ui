@"
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# Virtual environment
venv/
.venv/
env/
ENV/

# Environment / secrets
.env
.env.*
*.env

# Databases (auto-created at runtime)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Vector store (rebuilt on startup)
chroma_db/
faiss_index/
rag-documents/

# Uploaded / indexed documents
uploaded_docs/
*.pdf
*.docx

# Generated blog output (auto-created at runtime)
blogs/

# Local testing / scratch files
addtional_files_for_testing/

# Streamlit cache
.streamlit/secrets.toml

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Windows binaries / compiled
*.dll
*.so
*.exe

# Logs
*.log
logs/

# Build / dist
dist/
build/
*.egg-info/
"@ | Set-Content -Encoding utf8 .gitignore